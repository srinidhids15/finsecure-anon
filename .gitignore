# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.coverage
htmlcov/

# --- Environments ---
.venv/
venv/
.env

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store

# --- Data: NEVER commit downloaded datasets or private documents ---
# Folder structure is kept via .gitkeep files; contents are ignored.
data/raw/*
data/processed/*
data/private/*
!data/**/.gitkeep
# Small, hand-written, fully synthetic examples are allowed in data/samples/.

# Any PDFs anywhere except the synthetic samples folder.
*.pdf
!data/samples/*.pdf

# --- Models: trained artifacts are rebuilt, not committed ---
models/*
!models/.gitkeep

# --- Streamlit local secrets ---
.streamlit/secrets.toml

# --- Evaluation reports (generated, reproducible) ---
reports/
